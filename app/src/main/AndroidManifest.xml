<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExampleApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExampleTheme"
        tools:targetApi="31"
        >
        
        <!-- Main Activity with Navigation -->
        <activity
            android:name="com.gopay.example.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ExampleTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- SDK Test Activity -->
        <activity
            android:name="com.gopay.example.SDKTestActivity"
            android:exported="false"
            android:label="SDK Test Suite"
            android:theme="@style/Theme.ExampleTheme"
            android:parentActivityName="com.gopay.example.MainActivity" />
        
        <!-- Checkout Demo Activity -->
        <activity
            android:name="com.gopay.example.CheckoutDemoActivity"
            android:exported="false"
            android:label="Checkout Demo"
            android:theme="@style/Theme.ExampleTheme"
            android:parentActivityName="com.gopay.example.MainActivity" />

        <!-- Grants a content:// URI for the bank-transfer QR bitmap so the share sheet can attach
             it as an image; the checkout writes the PNG to cacheDir just before sharing. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>