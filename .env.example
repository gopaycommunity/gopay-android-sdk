# Demo app credentials. Copy to `.env` — that file is gitignored and nothing in it is
# compiled into the APK. Point the demo at another gateway by changing these values.
# A value runs to the end of its line, so a trailing `# comment` becomes part of the value.
#
# Sandbox:    https://gw.sandbox.gopay.com/gp-gw/api/4.0/
# Production: https://gate.gopay.com/gp-gw/api/4.0/

# Must be https://; the demo app sets usesCleartextTraffic="false".
GOPAY_DEMO_BASE_URL=
GOPAY_DEMO_CLIENT_ID=
GOPAY_DEMO_SHAREABLE_KEY=
# Merchant secret. It is here only because the demo fakes a merchant backend; a real app never
# carries one.
GOPAY_DEMO_CLIENT_SECRET=
GOPAY_DEMO_GOID=
